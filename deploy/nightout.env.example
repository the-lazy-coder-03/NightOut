SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nightout
SPRING_DATASOURCE_USERNAME=nightout
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_SQL_INIT_MODE=never
SPRING_BATCH_JDBC_INITIALIZE_SCHEMA=never
SPRING_SESSION_JDBC_INITIALIZE_SCHEMA=never
SPRING_FLYWAY_SCHEMAS=public

NIGHTOUT_SCHEMA_VERSION=1
NIGHTOUT_SCHEMA_RESET_ALLOWED=false

NIGHTOUT_BASE_URL=https://primepick.co.za
NIGHTOUT_RETENTION_DAYS=7
NIGHTOUT_MAX_UPLOAD_BYTES=10485760
NIGHTOUT_MAX_UPLOAD_COUNT=12
NIGHTOUT_SEED_DEMO=false

NIGHTOUT_STORAGE_PROVIDER=9drive
NIGHTOUT_LOCAL_STORAGE_PATH=/opt/nightout/storage
NIGHTOUT_9DRIVE_BASE_URL=https://drive.primepick.co.za
NIGHTOUT_9DRIVE_API_KEY=change-me
NIGHTOUT_9DRIVE_EMAIL=storage-account@example.com
NIGHTOUT_9DRIVE_PASSWORD=change-me
NIGHTOUT_9DRIVE_FOLDER_ID=
