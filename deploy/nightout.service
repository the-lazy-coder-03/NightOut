[Unit]
Description=CrowdCam Spring Boot service
After=network-online.target
Wants=network-online.target

[Service]
User=nightout
Group=nightout
WorkingDirectory=/opt/nightout
EnvironmentFile=-/etc/nightout/nightout.env
ExecStart=/opt/nightout/jre/bin/java -jar /opt/nightout/nightout.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
