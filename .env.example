SERVER_PORT=8090
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nightout
SPRING_DATASOURCE_USERNAME=nightout
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_SQL_INIT_MODE=never
SPRING_BATCH_JDBC_INITIALIZE_SCHEMA=never
SPRING_SESSION_JDBC_INITIALIZE_SCHEMA=never
SPRING_FLYWAY_SCHEMAS=public

NIGHTOUT_SCHEMA_VERSION=1
NIGHTOUT_SCHEMA_RESET_ALLOWED=false

NIGHTOUT_BASE_URL=http://localhost:8090
NIGHTOUT_TIME_ZONE=Africa/Johannesburg
NIGHTOUT_RETENTION_DAYS=7
NIGHTOUT_MAX_UPLOAD_BYTES=26214400
NIGHTOUT_MAX_REQUEST_BYTES=314572800
NIGHTOUT_MAX_UPLOAD_COUNT=12
NIGHTOUT_IMAGE_OPTIMIZATION_ENABLED=true
NIGHTOUT_IMAGE_OPTIMIZATION_MAX_DIMENSION=1080
NIGHTOUT_IMAGE_OPTIMIZATION_JPEG_QUALITY=0.82
NIGHTOUT_IMAGE_OPTIMIZATION_DELETE_ORIGINAL=true
NIGHTOUT_IMAGE_OPTIMIZATION_BATCH_SIZE=10
NIGHTOUT_SEED_DEMO=true
NIGHTOUT_SEED_ADMIN_EMAIL=admin@nightout.local
NIGHTOUT_SEED_CLUB_OWNER_EMAIL=owner@nightout.local

# Logto-only authentication. Create the Logto Traditional Web app first, then
# keep the real client secret in your local/server .env only.
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_LOGTO_ISSUER_URI=https://auth.nightout.co.za/oidc
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LOGTO_CLIENT_ID=replace-with-logto-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LOGTO_CLIENT_SECRET=replace-with-logto-client-secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LOGTO_SCOPE=openid,profile,email,roles
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_LOGTO_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# Use "local" for development/tests or "s3" for rclone-backed production storage.
NIGHTOUT_STORAGE_PROVIDER=local
NIGHTOUT_LOCAL_STORAGE_PATH=./storage/nightout

# Required when NIGHTOUT_STORAGE_PROVIDER=s3. The endpoint should be rclone
# serve s3 bound to localhost, authenticated with the same access/secret pair.
NIGHTOUT_S3_ENDPOINT=http://127.0.0.1:8080
NIGHTOUT_S3_BUCKET=nightout
NIGHTOUT_S3_REGION=us-east-1
NIGHTOUT_S3_ACCESS_KEY=replace-with-random-access-key
NIGHTOUT_S3_SECRET_KEY=replace-with-random-secret-key
NIGHTOUT_S3_PATH_STYLE=true
RCLONE_REMOTE=drive_primary:
