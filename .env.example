SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nightout
SPRING_DATASOURCE_USERNAME=nightout
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_SQL_INIT_MODE=never
SPRING_BATCH_JDBC_INITIALIZE_SCHEMA=never
SPRING_SESSION_JDBC_INITIALIZE_SCHEMA=never

NIGHTOUT_BASE_URL=http://localhost:8080
NIGHTOUT_RETENTION_DAYS=7
NIGHTOUT_MAX_UPLOAD_BYTES=10485760
NIGHTOUT_MAX_UPLOAD_COUNT=12
NIGHTOUT_SEED_DEMO=true

# Use "local" for development/tests or "9drive" for production storage.
NIGHTOUT_STORAGE_PROVIDER=local
NIGHTOUT_LOCAL_STORAGE_PATH=./storage/nightout

# Required when NIGHTOUT_STORAGE_PROVIDER=9drive.
# 9Drive upload uses the API key endpoint; download/delete use this same
# 9Drive account's authenticated file endpoints.
NIGHTOUT_9DRIVE_BASE_URL=http://localhost:4000
NIGHTOUT_9DRIVE_API_KEY=
NIGHTOUT_9DRIVE_EMAIL=
NIGHTOUT_9DRIVE_PASSWORD=
NIGHTOUT_9DRIVE_FOLDER_ID=
